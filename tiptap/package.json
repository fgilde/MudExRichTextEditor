  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --legal-comments=eof --outfile=../MudExRichTextEditor/wwwroot/lib/tiptap/tiptap.bundle.js",
    "minify": "esbuild ../MudExRichTextEditor/wwwroot/js/components/MudExRichTextEdit.js ../MudExRichTextEditor/wwwroot/js/components/MudExTiptapEdit.js --minify --outdir=../MudExRichTextEditor/wwwroot/js/components --out-extension:.js=.min.js --allow-overwrite"
  },
