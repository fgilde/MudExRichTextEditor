@using MudExRichTextEditor.Types

@* Quill binds these buttons/selects itself through its toolbar module, based on the ql-* classes. *@
@foreach (var group in Tools.GroupBy(t => t.Group).OrderBy(g => g.Key))
{
    <span class="ql-formats">
        @foreach (var tool in group)
        {
            if (tool is CustomTool custom)
            {
                <QuillToolButton Color="@(custom.Color(custom, Editor))" OnClick="@(() => custom.OnClick(custom, Editor))" Icon="@(custom.Icon(custom, Editor))" Tooltip="@Editor.TryLocalize(custom.Tooltip(custom, Editor))"></QuillToolButton>
            }
            else if (tool.Options != null)
            {
                <select class="@(tool.Class)">
                    @foreach (var option in tool.Options)
                    {
                        <option value="@option"></option>
                    }
                </select>
            }
            else if (!string.IsNullOrEmpty(tool.Value))
            {
                <button class="@(tool.Class)" value="@(tool.Value)"></button>
            }
            else
            {
                <button class="@(tool.Class)"></button>
            }
        }
    </span>
}

@code {
    [Parameter] public QuillTool[] Tools { get; set; } = [];
    [Parameter] public IMudExRichTextEdit Editor { get; set; }
}
